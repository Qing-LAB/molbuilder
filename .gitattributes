# Default to LF line endings on checkout for all text files.  This
# avoids the WSL/Windows mixed-checkout warning storm we'd otherwise
# get on every `git status` after the molwatch tree was merged in
# from a CRLF-normalised checkout.
* text=auto eol=lf

# Vendored minified JS: keep out of normal diff output (giant
# single-line files; treat as binary for diff/merge purposes).
molbuilder/web/static/vendor/*.js -diff -merge linguist-vendored

# Always-binary patterns -- never get the LF treatment.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.psml binary
