@article{Besley2008,
  author  = {Besley, Nicholas A. and Bryan, James A.},
  title   = {Partial {H}essian Vibrational Analysis of Organic Molecules
             Adsorbed on {Si}(100)},
  journal = {The Journal of Physical Chemistry C},
  volume  = {112},
  number  = {11},
  pages   = {4308--4314},
  year    = {2008},
  doi     = {10.1021/jp076167x}
  % PHVA in practice, and the clearest statement of WHICH Hessian is
  % sliced: "these derivatives are computed for the adsorbate-molecule
