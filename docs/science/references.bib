  journal = {International Journal of Quantum Chemistry},
  volume  = {65},
  number  = {5},
  pages   = {827--838},
  year    = {1997},
  doi     = {10.1002/(SICI)1097-461X(1997)65:5<827::AID-QUA47>3.0.CO;2-U}
  % THE ORIGIN of the partial-Hessian approach: diagonalise a mass-weighted
