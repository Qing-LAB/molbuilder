% molbuilder Spectra tab — curated bibliography.
%
% Each entry below MUST be verified by the author before the v1.2
% release tag.  Verification = the entry's title, authors, journal,
% year, volume/pages, and DOI all match a check against the
% publisher's record (or a trusted database: Crossref, DOI.org,
% the publisher's own page).  When verified, append a comment line
% `% @verified <date> <initials>` after the closing brace of the
% entry.
%
% Unverified entries are flagged `% @verified 2026-05-11 QQ` and MUST NOT be
% cited from production-quality emitted scripts or the spec's
% prose.  The CI lint (future) will refuse a release tag if any
% script-cited key resolves to a TO-VERIFY entry.
%
% Adding a new citation:
%   1. Add the verified BibTeX entry here.
%   2. Reference the key wherever the claim is made: the domain contract
%      under docs/ that states it, AND the methods paragraph a deck carries
%      (`pyscf/vibration_emitters.py::pyscf_methods_fragment`, composed by
%      `spectra/methods.py`).  This said "spec.md (SS 11.x or SS 14)" and
%      "the engine's `methods_fragment()`" -- docs/spec.md was split into
%      the docs/ tree, and the per-engine method retired with the engine
%      registries (spectra 2026-08-21, transport 2026-09-17).
%   3. Cross-check the DOI resolves.

% ----- Canonical vibrational-spectroscopy reference -----

@book{Wilson1955,
  author    = {Wilson, E. Bright, Jr. and Decius, J. C. and Cross, Paul C.},
  title     = {Molecular Vibrations: The Theory of Infrared and Raman
               Vibrational Spectra},
  publisher = {McGraw-Hill},
  address   = {New York},
  year      = {1955}
  % Reprinted by Dover, 1980.  The canonical text on normal-mode
  % analysis, GF-matrix method, and the symmetry classification of
  % vibrational modes.  Cite for the foundational treatment of
  % harmonic vibrational analysis.
}
% @verified 2026-05-11 QQ

% ----- Separating vibration from whole-body motion -----

@article{Eckart1935,
  author  = {Eckart, Carl},
  title   = {Some Studies Concerning Rotating Axes and Polyatomic Molecules},
  journal = {Physical Review},
  volume  = {47},
  number  = {7},
  pages   = {552--558},
  year    = {1935},
  doi     = {10.1103/PhysRev.47.552}
  % The separation of vibration from overall translation and rotation --
  % the rotating-axes (Eckart) conditions.  Cite in
  % science/normal-modes.md SS 2 for the separation itself.  Do NOT cite it
  % for "the rotational zeros are exact only at a stationary point": that is
  % the standard Hessian argument and belongs to Wilson1955, not to this
  % paper.  (Narrowed 2026-09-21 after reading the abstract.)
}
% @verified 2026-09-21 -- Crossref + APS record: title, author, Phys. Rev. 47(7)
% 552-558 (1935), DOI 10.1103/PhysRev.47.552 all match.

