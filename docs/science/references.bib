@article{Ghysels2007,
  author  = {Ghysels, An and Van Neck, Dimitri and Van Speybroeck, Veronique
             and Verstraelen, Toon and Waroquier, Michel},
  title   = {Vibrational modes in partially optimized molecular systems},
  journal = {Journal of Chemical Physics},
  volume  = {126},
  number  = {22},
  pages   = {224102},
  year    = {2007},
  doi     = {10.1063/1.2737444}
  % The mobile block Hessian (MBH), an extension of Head's partial Hessian
  % to partially optimised systems.  Its abstract is the reason this entry
  % is here: the method "avoids artificially introduced imaginary
  % frequencies and keeps track of the invariance under global translations
  % and rotations" -- the exact concern science/normal-modes.md SS 3 governs.
  % Cite beside Head1997/LiJensen2002 wherever the residual whole-body
  % motion of a partially frozen system is discussed.
}
% @verified 2026-09-21 -- Crossref: title, five authors, J. Chem. Phys.
