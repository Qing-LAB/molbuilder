% ----- Canonical vibrational-spectroscopy reference -----

@book{Wilson1955,
  author    = {Wilson, E. Bright, Jr. and Decius, J. C. and Cross, Paul C.},
  title     = {Molecular Vibrations: The Theory of Infrared and Raman
               Vibrational Spectra},
  publisher = {McGraw-Hill},
  address   = {New York},
  year      = {1955}
  % Reprinted by Dover, 1980.  The canonical text on normal-mode
  % analysis, GF-matrix method, and the symmetry classification of
  % vibrational modes.  Cite for the foundational treatment of
  % harmonic vibrational analysis.
}
% @verified 2026-05-11 QQ

