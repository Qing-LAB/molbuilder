% ----- Anharmonicity bounds on displacement amplitude -----

@book{Mills1972,
  author    = {Mills, Ian M.},
  title     = {Vibration-Rotation Structure in Asymmetric- and
               Symmetric-Top Molecules},
  booktitle = {Molecular Spectroscopy: Modern Research},
  editor    = {Rao, K. Narahari and Mathews, C. Weldon},
  publisher = {Academic Press},
  address   = {New York},
  pages     = {115--140},
  year      = {1972}
  % Chapter on anharmonic vibration-rotation coupling in asymmetric
  % tops.  Provides the general framework that constrains the
  % magnitude of cubic anharmonicity in molecular potentials.  The
  % specific [0.04, 0.20] Å displacement-amplitude range used by
  % the Spectra tab is a contemporary-practice heuristic, not a
  % bound derived from this source -- Mills 1972 explains why
  % anharmonic bounds exist; the numerical range comes from
  % empirical convergence studies in modern quantum chemistry
  % packages.  Cite for the general framework, not for the specific
  % number.
}
% @verified 2026-05-11 QQ

